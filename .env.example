# Copy to .env.local for local runs (never commit it). In production these live in
# GitHub (Settings > Secrets and variables > Actions) and Vercel (Project > Settings > Environment Variables).

# Google AI Studio, for AI news summaries (pipeline only). https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: pin one Gemini model instead of trying free-tier Flash models in turn
GEMINI_MODEL=

# The Guardian Open Platform, developer key. https://open-platform.theguardian.com/access/
# Needed in GitHub (news) AND in Vercel (interest search, local news for any city)
GUARDIAN_API_KEY=

# NASA picture of the day. https://api.nasa.gov (works without one, with low limits)
NASA_API_KEY=

# API-Football free plan, for live scores. https://dashboard.api-football.com/register (Vercel only)
API_FOOTBALL_KEY=

# Optional backup photos when a story has none of its own
# https://unsplash.com/developers  and  https://www.pexels.com/api/
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# Optional: local regions to summarise first (BBC region ids from pipeline/sources.ts), comma-separated
PRIORITY_REGIONS=london

# Accounts and sync. The app only ever gets SUPABASE_URL and SUPABASE_ANON_KEY (Supabase → Project Settings → API Keys).
# The service role key is for GitHub Actions only (admin page, later). Never put it in the app.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: 1 = sign in with a code sent by email instead of a password (needs your own SMTP in Supabase, see SETUP.md)
SUPABASE_EMAIL_CODES=

# Feedback emails: every note from the feedback button is emailed to Jasper. https://resend.com → API Keys (Vercel only).
# Make the Resend account with the address in FEEDBACK_TO (until a domain is verified, Resend only sends to that address).
RESEND_API_KEY=
# Optional: where feedback goes (default jasperhayward@me.com) and who it's from once a domain is verified in Resend
FEEDBACK_TO=
FEEDBACK_FROM=

# Notifications (web push). Make a pair once with: npx web-push generate-vapid-keys
# Public key: Vercel AND GitHub. Private key: GitHub only. The sender also needs SUPABASE_SERVICE_ROLE_KEY in GitHub.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
