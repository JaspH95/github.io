{
  "phase": 1,
  "title": "Meeting the Family",
  "sourceNotes": "Family terms cross-checked against multiple Romanian vocabulary references (incl. Talkpal, RomanianPod101 family-terms lists) for standard forms plus common affectionate variants (mamaie/tataie). Common-questions phrasing grounded in RomanianPod101's conversational-questions material and general Romanian grammar references for question-word usage. Flag anything that sounds off for a native-speaker spot check.",
  "sections": [
    { "id": "intro", "title": "Introducing Yourself" },
    { "id": "family", "title": "Family Vocabulary" },
    { "id": "address", "title": "Addressing Elders" },
    { "id": "questions", "title": "Questions You'll Be Asked" }
  ],
  "items": [
    { "id": "p1-001", "section": "intro", "ro": "Mă numesc ...", "en": "My name is ...", "phonetic": "muh noo-MESK", "ipa": "mə nuˈmesk", "example_ro": "Mă numesc Andrei.", "example_en": "My name is Andrei.", "formality": "neutral", "tags": ["intro", "core"] },
    { "id": "p1-002", "section": "intro", "ro": "Numele meu este ...", "en": "My name is ... (alternate phrasing)", "phonetic": "NOO-meh-leh MEH-oo YES-teh", "ipa": "ˈnumele ˈmeu ˈjeste", "example_ro": "Numele meu este Andrei.", "example_en": "My name is Andrei.", "formality": "neutral", "tags": ["intro"] },
    { "id": "p1-003", "section": "intro", "ro": "Sunt din ...", "en": "I'm from ...", "phonetic": "soont deen", "ipa": "sunt din", "example_ro": "Sunt din America.", "example_en": "I'm from America.", "formality": "neutral", "tags": ["intro", "core"] },
    { "id": "p1-004", "section": "intro", "ro": "Locuiesc în ...", "en": "I live in ...", "phonetic": "loh-koo-YESK uhn", "ipa": "lokuˈjesk ɨn", "example_ro": "Locuiesc în Londra.", "example_en": "I live in London.", "formality": "neutral", "tags": ["intro"] },
    { "id": "p1-005", "section": "intro", "ro": "Am ... ani", "en": "I am ... years old", "phonetic": "ahm ... ahn", "ipa": "am … anʲ", "example_ro": "Am douăzeci și opt de ani.", "example_en": "I am twenty-eight years old.", "formality": "neutral", "tags": ["intro", "core"] },
    { "id": "p1-006", "section": "intro", "ro": "Sunt prietenul Ilincăi", "en": "I'm Ilinca's boyfriend", "phonetic": "soont pree-YEH-teh-nool ee-LEEN-kai", "ipa": "sunt priˈetenul iˈlinkəj", "example_ro": "Bună ziua, sunt prietenul Ilincăi.", "example_en": "Hello, I'm Ilinca's boyfriend.", "formality": "formal", "tags": ["intro", "core"], "notes": "Swap the name in for whoever's grandparents you're meeting. Use prietena (female form) if you're the girlfriend introducing yourself." },
    { "id": "p1-007", "section": "intro", "ro": "Sunt prietena lui Andrei", "en": "I'm Andrei's girlfriend", "phonetic": "soont pree-YEH-teh-nah loo-ee ahn-DRAY", "ipa": "sunt priˈetena luj anˈdrej", "example_ro": "Sunt prietena lui Andrei, mă bucur să vă cunosc.", "example_en": "I'm Andrei's girlfriend, nice to meet you.", "formality": "formal", "tags": ["intro"] },
    { "id": "p1-008", "section": "intro", "ro": "Îmi pare bine de cunoștință", "en": "Nice to meet you", "phonetic": "uhm PAH-reh BEE-neh deh koo-nosh-TEEN-tsuh", "ipa": "ɨmʲ pare ˈbine de kunoʃˈtint͡sə", "example_ro": "Îmi pare bine de cunoștință, doamnă.", "example_en": "Nice to meet you, ma'am.", "formality": "formal", "tags": ["intro", "core"] },
    { "id": "p1-009", "section": "intro", "ro": "Mă bucur să vă cunosc", "en": "I'm glad to meet you (formal)", "phonetic": "muh BOO-koor suh vuh KOH-nosk", "ipa": "mə ˈbukur sə və ˈkunosk", "example_ro": "Mă bucur să vă cunosc, în sfârșit!", "example_en": "I'm glad to meet you, finally!", "formality": "formal", "tags": ["intro", "core"] },
    { "id": "p1-010", "section": "intro", "ro": "Și mie îmi pare bine", "en": "Nice to meet you too", "phonetic": "shee MEE-eh uhm PAH-reh BEE-neh", "ipa": "ʃi ˈmie ɨmʲ pare ˈbine", "example_ro": "— Îmi pare bine. — Și mie îmi pare bine.", "example_en": "— Nice to meet you. — Nice to meet you too.", "formality": "neutral", "tags": ["intro"] },

    { "id": "p1-011", "section": "family", "ro": "familie", "en": "family", "phonetic": "fah-MEE-lee-eh", "ipa": "faˈmilie", "example_ro": "Am o familie mare.", "example_en": "I have a big family.", "formality": "neutral", "tags": ["family", "core"] },
    { "id": "p1-012", "section": "family", "ro": "mamă", "en": "mother", "phonetic": "MAH-muh", "ipa": "ˈmamə", "example_ro": "Aceasta este mama Ilincăi.", "example_en": "This is Ilinca's mother.", "formality": "neutral", "tags": ["family", "core"] },
    { "id": "p1-013", "section": "family", "ro": "tată", "en": "father", "phonetic": "TAH-tuh", "ipa": "ˈtatə", "example_ro": "Tatăl meu locuiește departe.", "example_en": "My father lives far away.", "formality": "neutral", "tags": ["family", "core"] },
    { "id": "p1-014", "section": "family", "ro": "părinți", "en": "parents", "phonetic": "puh-REEN-tsy", "ipa": "pəˈrint͡sʲ", "example_ro": "Părinții mei sunt din State.", "example_en": "My parents are from the States.", "formality": "neutral", "tags": ["family", "core"] },
    { "id": "p1-015", "section": "family", "ro": "frate", "en": "brother", "phonetic": "FRAH-teh", "ipa": "ˈfrate", "example_ro": "Am un frate mai mic.", "example_en": "I have a younger brother.", "formality": "neutral", "tags": ["family", "core"] },
    { "id": "p1-016", "section": "family", "ro": "soră", "en": "sister", "phonetic": "SOH-ruh", "ipa": "ˈsorə", "example_ro": "Sora ei se numește Maria.", "example_en": "Her sister's name is Maria.", "formality": "neutral", "tags": ["family", "core"] },
    { "id": "p1-017", "section": "family", "ro": "bunica", "en": "grandmother", "phonetic": "boo-NEE-kah", "ipa": "buˈnika", "example_ro": "Bunica gătește foarte bine.", "example_en": "Grandma cooks very well.", "formality": "neutral", "tags": ["family", "core"] },
    { "id": "p1-018", "section": "family", "ro": "bunicul", "en": "grandfather", "phonetic": "boo-NEE-kool", "ipa": "buˈnikul", "example_ro": "Bunicul spune povești interesante.", "example_en": "Grandpa tells interesting stories.", "formality": "neutral", "tags": ["family", "core"] },
    { "id": "p1-019", "section": "family", "ro": "bunici", "en": "grandparents", "phonetic": "boo-NEECH", "ipa": "buˈnit͡ʃʲ", "example_ro": "Mergem la bunici duminică.", "example_en": "We're going to my grandparents' on Sunday.", "formality": "neutral", "tags": ["family", "core"] },
    { "id": "p1-020", "section": "family", "ro": "mătușă", "en": "aunt", "phonetic": "muh-TOO-shuh", "ipa": "məˈtuʃə", "example_ro": "Mătușa ei locuiește în Cluj.", "example_en": "Her aunt lives in Cluj.", "formality": "neutral", "tags": ["family"] },
    { "id": "p1-021", "section": "family", "ro": "unchi", "en": "uncle", "phonetic": "oonk-yee", "ipa": "ˈunkʲ", "example_ro": "Unchiul meu este medic.", "example_en": "My uncle is a doctor.", "formality": "neutral", "tags": ["family"] },
    { "id": "p1-022", "section": "family", "ro": "verișor / verișoară", "en": "cousin (male / female)", "phonetic": "veh-ree-SHOR / veh-ree-SHWAH-ruh", "ipa": "veriˈʃor / veriˈʃoarə", "example_ro": "Verișoara mea are aceeași vârstă cu mine.", "example_en": "My cousin is the same age as me.", "formality": "neutral", "tags": ["family"] },
    { "id": "p1-023", "section": "family", "ro": "nepot / nepoată", "en": "nephew or grandson / niece or granddaughter", "phonetic": "neh-POHT / neh-PWAH-tuh", "ipa": "neˈpot / neˈpoatə", "example_ro": "Nepoata lor locuiește în Timișoara.", "example_en": "Their granddaughter lives in Timișoara.", "formality": "neutral", "tags": ["family"] },
    { "id": "p1-024", "section": "family", "ro": "soț", "en": "husband", "phonetic": "sohts", "ipa": "sot͡s", "example_ro": "Soțul Mariei lucrează în construcții.", "example_en": "Maria's husband works in construction.", "formality": "neutral", "tags": ["family"] },
    { "id": "p1-025", "section": "family", "ro": "soție", "en": "wife", "phonetic": "soh-TSEE-eh", "ipa": "soˈt͡sie", "example_ro": "Soția lui este profesoară.", "example_en": "His wife is a teacher.", "formality": "neutral", "tags": ["family"] },
    { "id": "p1-026", "section": "family", "ro": "iubit / iubită", "en": "boyfriend / girlfriend", "phonetic": "yoo-BEET / yoo-BEE-tuh", "ipa": "juˈbit / juˈbitə", "example_ro": "El este iubitul meu.", "example_en": "He is my boyfriend.", "formality": "informal", "tags": ["family"], "notes": "Casual term; prieten/prietenă (see intro section) is a slightly more neutral way to introduce a partner to elders." },
    { "id": "p1-027", "section": "family", "ro": "copil / copii", "en": "child / children", "phonetic": "koh-PEEL / koh-PEE-ee", "ipa": "koˈpil / koˈpij", "example_ro": "Câți copii aveți?", "example_en": "How many children do you have?", "formality": "neutral", "tags": ["family"] },
    { "id": "p1-028", "section": "family", "ro": "nașă / naș", "en": "godmother / godfather", "phonetic": "NAH-shuh / nahsh", "ipa": "ˈnaʃə / naʃ", "example_ro": "Nașii lor vin și ei la nuntă.", "example_en": "Their godparents are coming to the wedding too.", "formality": "neutral", "tags": ["family"], "notes": "Godparents hold a socially significant, almost family-like role in Romanian culture." },
    { "id": "p1-029", "section": "family", "ro": "socru / soacră", "en": "father-in-law / mother-in-law", "phonetic": "SOH-kroo / SWAH-kruh", "ipa": "ˈsokru / ˈsoakrə", "example_ro": "Soacra mea gătește sarmale excelente.", "example_en": "My mother-in-law makes excellent sarmale.", "formality": "neutral", "tags": ["family"] },
    { "id": "p1-030", "section": "family", "ro": "rudă", "en": "relative", "phonetic": "ROO-duh", "ipa": "ˈrudə", "example_ro": "Avem multe rude în Moldova.", "example_en": "We have a lot of relatives in Moldova.", "formality": "neutral", "tags": ["family"] },

    { "id": "p1-031", "section": "address", "ro": "bunico!", "en": "Grandma! (calling out to her)", "phonetic": "boo-NEE-koh", "ipa": "buˈniko", "example_ro": "Bunico, ai nevoie de ajutor?", "example_en": "Grandma, do you need help?", "formality": "informal", "tags": ["address", "core"], "notes": "Vocative form — used to address grandma directly, not to talk about her." },
    { "id": "p1-032", "section": "address", "ro": "bunicule!", "en": "Grandpa! (calling out to him)", "phonetic": "boo-NEE-koo-leh", "ipa": "buˈnikule", "example_ro": "Bunicule, pot să te ajut?", "example_en": "Grandpa, can I help you?", "formality": "informal", "tags": ["address", "core"] },
    { "id": "p1-033", "section": "address", "ro": "mamaie", "en": "grandma (affectionate, common regional term)", "phonetic": "mah-MY-eh", "ipa": "maˈmaje", "example_ro": "Mamaie, mâncarea e delicioasă!", "example_en": "Grandma, the food is delicious!", "formality": "informal", "tags": ["address"], "notes": "Affectionate alternative to bunica, especially common with children and grandchildren — check what the family actually uses." },
    { "id": "p1-034", "section": "address", "ro": "tataie", "en": "grandpa (affectionate, common regional term)", "phonetic": "tah-TY-eh", "ipa": "taˈtaje", "example_ro": "Tataie, ce mai faci?", "example_en": "Grandpa, how are you?", "formality": "informal", "tags": ["address"] },
    { "id": "p1-035", "section": "address", "ro": "doamnă", "en": "Mrs. / madam", "phonetic": "DWAHM-nuh", "ipa": "ˈdoamnə", "example_ro": "Bună ziua, doamnă Popescu.", "example_en": "Hello, Mrs. Popescu.", "formality": "formal", "tags": ["address", "core"], "notes": "Use with a surname or on its own as a respectful, formal address for an older woman you don't yet call bunico." },
    { "id": "p1-036", "section": "address", "ro": "domnule", "en": "Mr. / sir", "phonetic": "dohm-NOO-leh", "ipa": "domˈnule", "example_ro": "Mulțumesc, domnule Popescu.", "example_en": "Thank you, Mr. Popescu.", "formality": "formal", "tags": ["address", "core"] },

    { "id": "p1-037", "section": "questions", "ro": "Câți ani ai?", "en": "How old are you? (informal)", "phonetic": "kuhts ahn eye?", "ipa": "kɨt͡s anʲ aj", "example_ro": "Câți ani ai acum?", "example_en": "How old are you now?", "formality": "informal", "tags": ["questions", "core"] },
    { "id": "p1-038", "section": "questions", "ro": "Câți ani aveți?", "en": "How old are you? (formal)", "phonetic": "kuhts ahn ah-VETS?", "ipa": "kɨt͡s anʲ aˈvet͡s", "example_ro": "Dacă îmi permiteți, câți ani aveți?", "example_en": "If I may ask, how old are you?", "formality": "formal", "tags": ["questions"] },
    { "id": "p1-039", "section": "questions", "ro": "Cu ce te ocupi?", "en": "What do you do (for work)? (informal)", "phonetic": "koo cheh teh oh-KOOP?", "ipa": "ku t͡ʃe te oˈkupʲ", "example_ro": "Cu ce te ocupi acum?", "example_en": "What do you do now?", "formality": "informal", "tags": ["questions", "core"] },
    { "id": "p1-040", "section": "questions", "ro": "Cu ce vă ocupați?", "en": "What do you do (for work)? (formal)", "phonetic": "koo cheh vuh oh-koo-PAHTS?", "ipa": "ku t͡ʃe və okuˈpat͡s", "example_ro": "Cu ce vă ocupați, dacă pot întreba?", "example_en": "What do you do, if I can ask?", "formality": "formal", "tags": ["questions"] },
    { "id": "p1-041", "section": "questions", "ro": "Sunt ...", "en": "I am a ... (profession)", "phonetic": "soont", "ipa": "sunt", "example_ro": "Sunt inginer.", "example_en": "I am an engineer.", "formality": "neutral", "tags": ["questions", "core"] },
    { "id": "p1-042", "section": "questions", "ro": "Îți place România?", "en": "Do you like Romania? (informal)", "phonetic": "uhts PLAH-cheh roh-MUH-nee-ah?", "ipa": "ɨt͡s ˈplat͡ʃe roˈmɨnia", "example_ro": "Îți place România până acum?", "example_en": "Do you like Romania so far?", "formality": "informal", "tags": ["questions", "core"] },
    { "id": "p1-043", "section": "questions", "ro": "Vă place România?", "en": "Do you like Romania? (formal)", "phonetic": "vuh PLAH-cheh roh-MUH-nee-ah?", "ipa": "və ˈplat͡ʃe roˈmɨnia", "example_ro": "Vă place România, domnule?", "example_en": "Do you like Romania, sir?", "formality": "formal", "tags": ["questions"] },
    { "id": "p1-044", "section": "questions", "ro": "Îmi place foarte mult", "en": "I like it very much", "phonetic": "uhm PLAH-cheh FWAHR-teh moolt", "ipa": "ɨmʲ ˈplat͡ʃe ˈfoarte mult", "example_ro": "Îmi place foarte mult, mai ales mâncarea.", "example_en": "I like it very much, especially the food.", "formality": "neutral", "tags": ["questions", "core"] },
    { "id": "p1-045", "section": "questions", "ro": "De cât timp înveți română?", "en": "How long have you been learning Romanian?", "phonetic": "deh kuht teemp uhn-VETSY roh-MUH-nuh?", "ipa": "de kɨt timp ɨnˈvet͡sʲ roˈmɨnə", "example_ro": "De cât timp înveți română acum?", "example_en": "How long have you been learning Romanian now?", "formality": "informal", "tags": ["questions"] },
    { "id": "p1-046", "section": "questions", "ro": "Învăț de ... luni", "en": "I've been learning for ... months", "phonetic": "uhn-VUHTS deh ... loon", "ipa": "ɨnˈvət͡s de … lunʲ", "example_ro": "Învăț de trei luni.", "example_en": "I've been learning for three months.", "formality": "neutral", "tags": ["questions"] },
    { "id": "p1-047", "section": "questions", "ro": "Cum ați cunoscut-o pe Ilinca?", "en": "How did you meet Ilinca? (formal, asked to you)", "phonetic": "koom ahts koo-nos-KOOT oh peh ee-LEEN-kah?", "ipa": "kum at͡s kunosˈkut o pe iˈlinka", "example_ro": "Povestește-ne, cum ați cunoscut-o pe Ilinca?", "example_en": "Tell us, how did you meet Ilinca?", "formality": "formal", "tags": ["questions"] },
    { "id": "p1-048", "section": "questions", "ro": "Ești căsătorit / căsătorită?", "en": "Are you married? (to a man / to a woman)", "phonetic": "yesht kuh-suh-toh-REET / kuh-suh-toh-REE-tuh", "ipa": "jeʃtʲ kəsətoˈrit / kəsətoˈritə", "example_ro": "Ești căsătorit?", "example_en": "Are you married?", "formality": "informal", "tags": ["questions"] },
    { "id": "p1-049", "section": "questions", "ro": "Aveți copii?", "en": "Do you have children?", "phonetic": "ah-VETS koh-PEE-ee?", "ipa": "aˈvet͡s koˈpij", "example_ro": "Aveți copii sau plănuiți?", "example_en": "Do you have children, or are you planning to?", "formality": "formal", "tags": ["questions"] },
    { "id": "p1-050", "section": "questions", "ro": "Unde ai învățat română?", "en": "Where did you learn Romanian?", "phonetic": "OON-deh eye uhn-vuh-TSAHT roh-MUH-nuh?", "ipa": "ˈunde aj ɨnvəˈt͡sat roˈmɨnə", "example_ro": "Unde ai învățat română, de fapt?", "example_en": "Where did you actually learn Romanian?", "formality": "informal", "tags": ["questions", "core"] }
  ]
}
