{
  "phase": 0,
  "title": "Foundations",
  "sourceNotes": "Sound values cross-checked against Wikipedia's Help:IPA/Romanian and Wikibooks' Romanian pronunciation guide. Survival phrases grounded in Peace Corps Romania survival-language materials and standard phrasebook sources (Wikivoyage-style). Tu/dumneavoastră usage grounded in Romanian grammar reference material (Elon.io Romanian Grammar). Numbers cross-checked against standard Romanian numeral references. Flag anything that sounds off for a native-speaker spot check.",
  "sections": [
    { "id": "sounds", "title": "The Sound System" },
    { "id": "greetings", "title": "Greetings & Courtesy" },
    { "id": "learner", "title": "Learner Survival Phrases" },
    { "id": "formality", "title": "Tu vs. Dumneavoastră" },
    { "id": "numbers", "title": "Numbers 1–20" }
  ],
  "items": [
    { "id": "p0-001", "section": "sounds", "ro": "ă", "en": "a schwa sound, like the \"a\" in \"about\"", "phonetic": "uh", "ipa": "ə", "example_ro": "măr", "example_en": "apple", "formality": "neutral", "tags": ["sound"], "notes": "The most common vowel in Romanian. Never stressed on its own in most words." },
    { "id": "p0-002", "section": "sounds", "ro": "â", "en": "a deep, central \"i\" sound with no English equivalent", "phonetic": "ih (further back in the mouth)", "ipa": "ɨ", "example_ro": "român", "example_en": "Romanian", "formality": "neutral", "tags": ["sound"], "notes": "Same sound as î — â is used inside a word, î at the start or end." },
    { "id": "p0-003", "section": "sounds", "ro": "î", "en": "identical sound to â", "phonetic": "ih (further back in the mouth)", "ipa": "ɨ", "example_ro": "înțeleg", "example_en": "I understand", "formality": "neutral", "tags": ["sound"], "notes": "î appears at the start or end of a word; â appears in the middle." },
    { "id": "p0-004", "section": "sounds", "ro": "ș", "en": "\"sh\" as in \"shoe\"", "phonetic": "sh", "ipa": "ʃ", "example_ro": "șase", "example_en": "six", "formality": "neutral", "tags": ["sound"] },
    { "id": "p0-005", "section": "sounds", "ro": "ț", "en": "\"ts\" as in \"cats\"", "phonetic": "ts", "ipa": "t͡s", "example_ro": "țară", "example_en": "country", "formality": "neutral", "tags": ["sound"] },
    { "id": "p0-006", "section": "sounds", "ro": "ce / ci", "en": "soft \"che\" / \"chi\"", "phonetic": "cheh / chee", "ipa": "t͡ʃe / t͡ʃi", "example_ro": "cer", "example_en": "sky (sounds like \"cher\")", "formality": "neutral", "tags": ["sound"] },
    { "id": "p0-007", "section": "sounds", "ro": "che / chi", "en": "hard \"ke\" / \"ki\"", "phonetic": "keh / kee", "ipa": "ke / ki", "example_ro": "chelner", "example_en": "waiter (sounds like \"KEL-ner\")", "formality": "neutral", "tags": ["sound"] },
    { "id": "p0-008", "section": "sounds", "ro": "ge / gi", "en": "soft \"je\" / \"ji\"", "phonetic": "jeh / jee", "ipa": "d͡ʒe / d͡ʒi", "example_ro": "ger", "example_en": "frost (sounds like \"jer\")", "formality": "neutral", "tags": ["sound"] },
    { "id": "p0-009", "section": "sounds", "ro": "ghe / ghi", "en": "hard \"ge\" / \"gi\"", "phonetic": "geh / gee", "ipa": "ɡe / ɡi", "example_ro": "ghid", "example_en": "guide (sounds like \"geed\")", "formality": "neutral", "tags": ["sound"] },
    { "id": "p0-010", "section": "sounds", "ro": "r", "en": "a lightly rolled/tapped r, tongue tip against the roof of the mouth", "phonetic": "rr (tapped)", "ipa": "r", "example_ro": "rău", "example_en": "bad", "formality": "neutral", "tags": ["sound"] },

    { "id": "p0-011", "section": "greetings", "ro": "Bună ziua", "en": "Hello / Good day", "phonetic": "BOO-nuh ZEE-wah", "ipa": "ˈbunə ˈziwa", "example_ro": "Bună ziua! Ce mai faceți?", "example_en": "Good day! How are you?", "formality": "formal", "tags": ["greeting", "core"], "notes": "Safe, polite greeting any time of day." },
    { "id": "p0-012", "section": "greetings", "ro": "Bună dimineața", "en": "Good morning", "phonetic": "BOO-nuh dee-mee-NYAH-tsa", "ipa": "ˈbunə dimiˈneat͡sa", "example_ro": "Bună dimineața, familie!", "example_en": "Good morning, family!", "formality": "neutral", "tags": ["greeting", "core"] },
    { "id": "p0-013", "section": "greetings", "ro": "Bună seara", "en": "Good evening", "phonetic": "BOO-nuh SYAH-rah", "ipa": "ˈbunə ˈseara", "example_ro": "Bună seara tuturor!", "example_en": "Good evening everyone!", "formality": "neutral", "tags": ["greeting", "core"] },
    { "id": "p0-014", "section": "greetings", "ro": "Noapte bună", "en": "Good night", "phonetic": "NWAHP-teh BOO-nuh", "ipa": "ˈnoapte ˈbunə", "example_ro": "Noapte bună, ne vedem mâine.", "example_en": "Good night, see you tomorrow.", "formality": "neutral", "tags": ["greeting", "core"] },
    { "id": "p0-015", "section": "greetings", "ro": "Salut", "en": "Hi / Bye (casual)", "phonetic": "sah-LOOT", "ipa": "saˈlut", "example_ro": "Salut! Ce faci?", "example_en": "Hi! What's up?", "formality": "informal", "tags": ["greeting", "core"], "notes": "Use with people your own age, not with grandparents." },
    { "id": "p0-016", "section": "greetings", "ro": "La revedere", "en": "Goodbye", "phonetic": "lah reh-veh-DEH-reh", "ipa": "la reveˈdere", "example_ro": "La revedere și mulțumesc!", "example_en": "Goodbye and thank you!", "formality": "formal", "tags": ["greeting", "core"] },
    { "id": "p0-017", "section": "greetings", "ro": "Pa / Pa pa", "en": "Bye (casual)", "phonetic": "pah / pah-pah", "ipa": "pa", "example_ro": "Pa pa, ne auzim mâine!", "example_en": "Bye, talk tomorrow!", "formality": "informal", "tags": ["greeting", "core"] },
    { "id": "p0-018", "section": "greetings", "ro": "Ce mai faci?", "en": "How are you?", "phonetic": "cheh my FAHCH?", "ipa": "t͡ʃe maj fat͡ʃʲ", "example_ro": "Salut! Ce mai faci?", "example_en": "Hi! How are you?", "formality": "informal", "tags": ["greeting", "core"] },
    { "id": "p0-019", "section": "greetings", "ro": "Ce mai faceți?", "en": "How are you? (to an elder/group)", "phonetic": "cheh my fah-CHETSy?", "ipa": "t͡ʃe maj faˈt͡ʃetsʲ", "example_ro": "Bună ziua! Ce mai faceți?", "example_en": "Good day! How are you?", "formality": "formal", "tags": ["greeting", "core"], "notes": "Use this form with grandparents and anyone you'd address as dumneavoastră." },
    { "id": "p0-020", "section": "greetings", "ro": "Bine, mulțumesc. Și tu?", "en": "Fine, thank you. And you?", "phonetic": "BEE-neh mool-tsoo-MESK shee too", "ipa": "ˈbine mult͡suˈmesk ʃi tu", "example_ro": "— Ce mai faci? — Bine, mulțumesc. Și tu?", "example_en": "— How are you? — Fine, thank you. And you?", "formality": "informal", "tags": ["greeting", "core"] },
    { "id": "p0-021", "section": "greetings", "ro": "Bine, mulțumesc. Și dumneavoastră?", "en": "Fine, thank you. And you? (formal)", "phonetic": "BEE-neh mool-tsoo-MESK shee doom-neh-ah-VWAH-strah", "ipa": "ˈbine mult͡suˈmesk ʃi dumnjaˈvoastrə", "example_ro": "— Ce mai faceți? — Bine, mulțumesc. Și dumneavoastră?", "example_en": "— How are you? — Fine, thank you. And you?", "formality": "formal", "tags": ["greeting", "core"] },
    { "id": "p0-022", "section": "greetings", "ro": "Mulțumesc", "en": "Thank you", "phonetic": "mool-tsoo-MESK", "ipa": "mult͡suˈmesk", "example_ro": "Mulțumesc pentru cină!", "example_en": "Thank you for dinner!", "formality": "neutral", "tags": ["courtesy", "core"] },
    { "id": "p0-023", "section": "greetings", "ro": "Mulțumesc mult", "en": "Thank you very much", "phonetic": "mool-tsoo-MESK moolt", "ipa": "mult͡suˈmesk mult", "example_ro": "Mulțumesc mult pentru tot!", "example_en": "Thank you very much for everything!", "formality": "neutral", "tags": ["courtesy", "core"] },
    { "id": "p0-024", "section": "greetings", "ro": "Cu plăcere", "en": "You're welcome", "phonetic": "koo pluh-CHEH-reh", "ipa": "ku pləˈt͡ʃere", "example_ro": "— Mulțumesc! — Cu plăcere.", "example_en": "— Thank you! — You're welcome.", "formality": "neutral", "tags": ["courtesy", "core"] },
    { "id": "p0-025", "section": "greetings", "ro": "Te rog", "en": "Please (informal)", "phonetic": "teh rohg", "ipa": "te roɡ", "example_ro": "Ajută-mă, te rog.", "example_en": "Help me, please.", "formality": "informal", "tags": ["courtesy", "core"] },
    { "id": "p0-026", "section": "greetings", "ro": "Vă rog", "en": "Please (formal)", "phonetic": "vuh rohg", "ipa": "və roɡ", "example_ro": "Repetați, vă rog.", "example_en": "Repeat, please.", "formality": "formal", "tags": ["courtesy", "core"] },
    { "id": "p0-027", "section": "greetings", "ro": "Scuze", "en": "Sorry / Excuse me (casual)", "phonetic": "SKOO-zeh", "ipa": "ˈskuze", "example_ro": "Scuze, am întârziat.", "example_en": "Sorry, I'm late.", "formality": "informal", "tags": ["courtesy", "core"] },
    { "id": "p0-028", "section": "greetings", "ro": "Scuzați-mă", "en": "Excuse me (formal)", "phonetic": "skoo-ZAH-tsee-muh", "ipa": "skuˈzat͡si mə", "example_ro": "Scuzați-mă, unde este baia?", "example_en": "Excuse me, where is the bathroom?", "formality": "formal", "tags": ["courtesy", "core"] },
    { "id": "p0-029", "section": "greetings", "ro": "Îmi pare rău", "en": "I'm sorry", "phonetic": "uhm pah-reh ruh-OO", "ipa": "ɨmʲ pare rəw", "example_ro": "Îmi pare rău, nu am înțeles.", "example_en": "I'm sorry, I didn't understand.", "formality": "neutral", "tags": ["courtesy", "core"] },
    { "id": "p0-030", "section": "greetings", "ro": "Da", "en": "Yes", "phonetic": "dah", "ipa": "da", "example_ro": "Da, mulțumesc.", "example_en": "Yes, thank you.", "formality": "neutral", "tags": ["core"] },
    { "id": "p0-031", "section": "greetings", "ro": "Nu", "en": "No", "phonetic": "noo", "ipa": "nu", "example_ro": "Nu, mulțumesc.", "example_en": "No, thank you.", "formality": "neutral", "tags": ["core"] },
    { "id": "p0-032", "section": "greetings", "ro": "Poate", "en": "Maybe", "phonetic": "PWAH-teh", "ipa": "ˈpoate", "example_ro": "Poate mai târziu.", "example_en": "Maybe later.", "formality": "neutral", "tags": ["core"] },

    { "id": "p0-033", "section": "learner", "ro": "Învăț limba română", "en": "I'm learning Romanian", "phonetic": "uhn-VUHTS LEEM-bah roh-MUH-nuh", "ipa": "ɨnˈvəts ˈlimba roˈmɨnə", "example_ro": "Bună ziua, învăț limba română.", "example_en": "Hello, I'm learning Romanian.", "formality": "neutral", "tags": ["learner", "core"], "notes": "A great opener — it signals patience is welcome." },
    { "id": "p0-034", "section": "learner", "ro": "Vorbesc puțină română", "en": "I speak a little Romanian", "phonetic": "vor-BESK poo-TSEE-nuh roh-MUH-nuh", "ipa": "vorˈbesk puˈt͡sinə roˈmɨnə", "example_ro": "Vorbesc puțină română, dar învăț.", "example_en": "I speak a little Romanian, but I'm learning.", "formality": "neutral", "tags": ["learner", "core"] },
    { "id": "p0-035", "section": "learner", "ro": "Vorbește mai rar, te rog", "en": "Please speak more slowly (informal)", "phonetic": "vor-BESH-teh my rahr teh rohg", "ipa": "vorˈbeʃte maj rar te roɡ", "example_ro": "Nu te supăra, vorbește mai rar, te rog.", "example_en": "Don't take it wrong, please speak more slowly.", "formality": "informal", "tags": ["learner", "core"] },
    { "id": "p0-036", "section": "learner", "ro": "Vorbiți mai rar, vă rog", "en": "Please speak more slowly (formal)", "phonetic": "vor-BEETS my rahr vuh rohg", "ipa": "vorˈbit͡s maj rar və roɡ", "example_ro": "Vorbiți mai rar, vă rog, abia am început.", "example_en": "Please speak more slowly, I've only just started.", "formality": "formal", "tags": ["learner", "core"], "notes": "The single most useful phrase for a first family visit." },
    { "id": "p0-037", "section": "learner", "ro": "Nu înțeleg", "en": "I don't understand", "phonetic": "noo uhn-tseh-LEHG", "ipa": "nu ɨnt͡seˈleɡ", "example_ro": "Îmi pare rău, nu înțeleg.", "example_en": "I'm sorry, I don't understand.", "formality": "neutral", "tags": ["learner", "core"] },
    { "id": "p0-038", "section": "learner", "ro": "Puteți repeta, vă rog?", "en": "Can you repeat that, please?", "phonetic": "poo-TETS reh-PEH-tah vuh rohg?", "ipa": "puˈtet͡s repeˈta və roɡ", "example_ro": "Nu am auzit bine, puteți repeta, vă rog?", "example_en": "I didn't hear well, can you repeat that, please?", "formality": "formal", "tags": ["learner", "core"] },
    { "id": "p0-039", "section": "learner", "ro": "Ce înseamnă asta?", "en": "What does that mean?", "phonetic": "cheh uhn-SYAHM-nuh AHS-tah?", "ipa": "t͡ʃe ɨnˈseamnə ˈasta", "example_ro": "Ce înseamnă cuvântul acesta?", "example_en": "What does this word mean?", "formality": "neutral", "tags": ["learner", "core"] },
    { "id": "p0-040", "section": "learner", "ro": "Cum se spune ... în română?", "en": "How do you say ... in Romanian?", "phonetic": "koom seh SPOO-neh ... uhn roh-MUH-nuh?", "ipa": "kum se ˈspune … ɨn roˈmɨnə", "example_ro": "Cum se spune \"family\" în română?", "example_en": "How do you say \"family\" in Romanian?", "formality": "neutral", "tags": ["learner", "core"] },

    { "id": "p0-041", "section": "formality", "ro": "tu", "en": "you (informal, singular)", "phonetic": "too", "ipa": "tu", "example_ro": "Tu ești sora Ilincăi.", "example_en": "You are Ilinca's sister.", "formality": "informal", "tags": ["grammar", "formality"], "notes": "Use with friends, partners, children, and people your own age you already know casually." },
    { "id": "p0-042", "section": "formality", "ro": "dumneavoastră", "en": "you (formal, singular or plural)", "phonetic": "doom-neh-ah-VWAH-strah", "ipa": "dumnjaˈvoastrə", "example_ro": "Dumneavoastră sunteți bunica Mariei.", "example_en": "You are Maria's grandmother.", "formality": "formal", "tags": ["grammar", "formality"], "notes": "Always takes the plural verb form (sunteți, aveți), even for one person. The safe default with anyone you don't already address informally — including grandparents, unless invited to switch to tu." },
    { "id": "p0-043", "section": "formality", "ro": "Cum te numești?", "en": "What's your name? (informal)", "phonetic": "koom teh noo-MESHT?", "ipa": "kum te nuˈmeʃtʲ", "example_ro": "Salut! Cum te numești?", "example_en": "Hi! What's your name?", "formality": "informal", "tags": ["grammar", "formality", "core"] },
    { "id": "p0-044", "section": "formality", "ro": "Cum vă numiți?", "en": "What's your name? (formal)", "phonetic": "koom vuh noo-MEETS?", "ipa": "kum və nuˈmit͡s", "example_ro": "Bună ziua! Cum vă numiți?", "example_en": "Good day! What's your name?", "formality": "formal", "tags": ["grammar", "formality", "core"], "notes": "The version to use meeting grandparents for the first time." },
    { "id": "p0-045", "section": "formality", "ro": "De unde ești?", "en": "Where are you from? (informal)", "phonetic": "deh OON-deh yesht?", "ipa": "de ˈunde jeʃtʲ", "example_ro": "De unde ești? Din America?", "example_en": "Where are you from? From America?", "formality": "informal", "tags": ["grammar", "formality", "core"] },
    { "id": "p0-046", "section": "formality", "ro": "De unde sunteți?", "en": "Where are you from? (formal)", "phonetic": "deh OON-deh soon-TETS?", "ipa": "de ˈunde sunˈtet͡s", "example_ro": "De unde sunteți, dacă îmi permiteți?", "example_en": "Where are you from, if I may ask?", "formality": "formal", "tags": ["grammar", "formality", "core"] },

    { "id": "p0-047", "section": "numbers", "ro": "unu", "en": "one", "phonetic": "OO-noo", "ipa": "ˈunu", "example_ro": "un pahar", "example_en": "one glass", "formality": "neutral", "tags": ["numbers"] },
    { "id": "p0-048", "section": "numbers", "ro": "doi", "en": "two", "phonetic": "doy", "ipa": "doj", "example_ro": "doi frați", "example_en": "two brothers", "formality": "neutral", "tags": ["numbers"] },
    { "id": "p0-049", "section": "numbers", "ro": "trei", "en": "three", "phonetic": "tray", "ipa": "trej", "example_ro": "trei surori", "example_en": "three sisters", "formality": "neutral", "tags": ["numbers"] },
    { "id": "p0-050", "section": "numbers", "ro": "patru", "en": "four", "phonetic": "PAH-troo", "ipa": "ˈpatru", "example_ro": "patru scaune", "example_en": "four chairs", "formality": "neutral", "tags": ["numbers"] },
    { "id": "p0-051", "section": "numbers", "ro": "cinci", "en": "five", "phonetic": "cheench", "ipa": "t͡ʃint͡ʃ", "example_ro": "cinci minute", "example_en": "five minutes", "formality": "neutral", "tags": ["numbers"] },
    { "id": "p0-052", "section": "numbers", "ro": "șase", "en": "six", "phonetic": "SHAH-seh", "ipa": "ˈʃase", "example_ro": "șase ore", "example_en": "six hours", "formality": "neutral", "tags": ["numbers"] },
    { "id": "p0-053", "section": "numbers", "ro": "șapte", "en": "seven", "phonetic": "SHAHP-teh", "ipa": "ˈʃapte", "example_ro": "șapte zile", "example_en": "seven days", "formality": "neutral", "tags": ["numbers"] },
    { "id": "p0-054", "section": "numbers", "ro": "opt", "en": "eight", "phonetic": "opt", "ipa": "opt", "example_ro": "opt ani", "example_en": "eight years", "formality": "neutral", "tags": ["numbers"] },
    { "id": "p0-055", "section": "numbers", "ro": "nouă", "en": "nine", "phonetic": "NOH-wuh", "ipa": "ˈnowə", "example_ro": "nouă luni", "example_en": "nine months", "formality": "neutral", "tags": ["numbers"] },
    { "id": "p0-056", "section": "numbers", "ro": "zece", "en": "ten", "phonetic": "ZEH-cheh", "ipa": "ˈzet͡ʃe", "example_ro": "zece cuvinte", "example_en": "ten words", "formality": "neutral", "tags": ["numbers"] },
    { "id": "p0-057", "section": "numbers", "ro": "unsprezece", "en": "eleven", "phonetic": "OON-spreh-zeh-cheh", "ipa": "ˈunsprezet͡ʃe", "example_ro": "unsprezece ani", "example_en": "eleven years", "formality": "neutral", "tags": ["numbers"] },
    { "id": "p0-058", "section": "numbers", "ro": "doisprezece", "en": "twelve", "phonetic": "doy-spreh-ZEH-cheh", "ipa": "dojˈsprezet͡ʃe", "example_ro": "doisprezece oameni", "example_en": "twelve people", "formality": "neutral", "tags": ["numbers"] },
    { "id": "p0-059", "section": "numbers", "ro": "treisprezece", "en": "thirteen", "phonetic": "tray-spreh-ZEH-cheh", "ipa": "trejˈsprezet͡ʃe", "example_ro": "treisprezece", "example_en": "thirteen", "formality": "neutral", "tags": ["numbers"] },
    { "id": "p0-060", "section": "numbers", "ro": "paisprezece", "en": "fourteen", "phonetic": "pie-spreh-ZEH-cheh", "ipa": "pajˈsprezet͡ʃe", "example_ro": "paisprezece", "example_en": "fourteen", "formality": "neutral", "tags": ["numbers"] },
    { "id": "p0-061", "section": "numbers", "ro": "cincisprezece", "en": "fifteen", "phonetic": "cheench-spreh-ZEH-cheh", "ipa": "t͡ʃint͡ʃˈsprezet͡ʃe", "example_ro": "cincisprezece", "example_en": "fifteen", "formality": "neutral", "tags": ["numbers"] },
    { "id": "p0-062", "section": "numbers", "ro": "șaisprezece", "en": "sixteen", "phonetic": "shy-spreh-ZEH-cheh", "ipa": "ʃajˈsprezet͡ʃe", "example_ro": "șaisprezece", "example_en": "sixteen", "formality": "neutral", "tags": ["numbers"] },
    { "id": "p0-063", "section": "numbers", "ro": "șaptesprezece", "en": "seventeen", "phonetic": "shahp-teh-spreh-ZEH-cheh", "ipa": "ˈʃaptesprezet͡ʃe", "example_ro": "șaptesprezece", "example_en": "seventeen", "formality": "neutral", "tags": ["numbers"] },
    { "id": "p0-064", "section": "numbers", "ro": "optsprezece", "en": "eighteen", "phonetic": "opt-spreh-ZEH-cheh", "ipa": "optˈsprezet͡ʃe", "example_ro": "optsprezece", "example_en": "eighteen", "formality": "neutral", "tags": ["numbers"] },
    { "id": "p0-065", "section": "numbers", "ro": "nouăsprezece", "en": "nineteen", "phonetic": "noh-wuh-spreh-ZEH-cheh", "ipa": "ˈnowəsprezet͡ʃe", "example_ro": "nouăsprezece", "example_en": "nineteen", "formality": "neutral", "tags": ["numbers"] },
    { "id": "p0-066", "section": "numbers", "ro": "douăzeci", "en": "twenty", "phonetic": "doh-wuh-ZECH", "ipa": "ˈdowəzet͡ʃʲ", "example_ro": "douăzeci de ani", "example_en": "twenty years", "formality": "neutral", "tags": ["numbers"] }
  ]
}
